# Rideshare Compare — Environment Variables
# Copy this file to .env.local and fill in your keys.

# Mapbox: Used for address autocomplete (client) and driving directions (server).
# Get a free token at https://account.mapbox.com/access-tokens/
# Set the SAME token for both — the NEXT_PUBLIC_ prefix exposes it to the browser.
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# OpenWeather: Used for weather-based price adjustments.
# Get a free API key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

